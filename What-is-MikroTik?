                <pre><code># Server তৈরি
/ip pool add name=pool1 ranges=192.168.1.10-192.168.1.200
/ip dhcp-server network add address=192.168.1.0/24 gateway=192.168.1.1 dns-server=8.8.8.8
/ip dhcp-server add name=dhcp1 interface=bridge1 address-pool=pool1 lease-time=1h disabled=no

