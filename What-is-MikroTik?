/ip dhcp-server lease print
/ip dhcp-server lease print where status=bound

# Static lease + rate limit
/ip dhcp-server lease add address=192.168.1.50 mac-address=AA:BB:CC:DD:EE:FF server=dhcp1 rate-limit=10M/10M

# Relay
/ip dhcp-relay add name=relay1 interface=ether2 dhcp-server=10.0.0.1 local-address=10.0.0.2 add-relay-info=yes

# Log
